<div>
    <h3>
        帳號登入
    </h3>
</div>

<form method="post">
    <div>
        <input
            id="username"
            type="text"
            name="username"
            placeholder="帳號"/>
    </div>

    <div>
        <input
            id="password"
            type="password"
            name="password"
            placeholder="密碼"/>
    </div>

    <div>
        <button
            id="loginButton"
            type="button">
            登入
        </button>
    </div>
</form>

@section Scripts
{
    <script src="~/js/Login/Index.js"></script>
}
