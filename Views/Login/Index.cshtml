<div>
    <h3>
        帳號登入
    </h3>
</div>

<form method="post">
    <div>
        <input
            id="username"
            type="text"
            name="username"
            maxlength="20"
            placeholder="帳號"/>
    </div>

    <div>
        <input
            id="password"
            type="password"
            name="password"
            placeholder="密碼"/>
    </div>

    <div>
        <button
            id="confirmButton"
            type="button">
            登入
        </button>
    </div>
</form>

<div>
    <button
        id="registerPageButton"
        type="button">
        前往註冊
    </button>
</div>

@section Scripts
{
    <script src="~/js/Login/Index.js"></script>
}